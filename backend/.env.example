# Copiar para .env e preencher antes de arrancar o backend
SECRET_KEY=
MONGO_URL=mongodb://localhost:27017
DB_NAME=accta_portal
CORS_ORIGINS=https://controlador.cv
FRONTEND_URL=https://controlador.cv
RESEND_API_KEY=
SENDER_EMAIL=noreply@controlador.cv

# Cloudflare Turnstile (anti-bot nos formularios publicos). Sem esta secret a
# verificacao fica desligada graciosamente (no-op). Site key (publica) vai no
# frontend via REACT_APP_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=
