# Vercel deploys only the frontend; everything else is dead weight in the upload.
backend/
scripts/
tasks/
test_reports/
memory/

# Backend artefacts that may get committed accidentally
backend/uploads/
backend/.coverage
**/__pycache__/
*.pyc

# Documentation (not needed at runtime)
*.md
!README.md

# Local Claude config
.claude/

# Local node artefacts (Vercel runs install fresh)
**/node_modules/

# Tests / dev artefacts
**/coverage/
**/.pytest_cache/
